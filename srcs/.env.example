# WP = WordPress; MDB = MariaDB; NGINX = Engine X

# Domain visitors, defined by the subject of the project, to access the NGINX
DOMAIN_NAME=[yourlogin].42.fr

HOST_LOGIN=[yourlogin]

# MDB will create a Database with the name specified that WP will use
MYSQL_DATABASE=wordpress

# MDB User that WP will use to connect to the database - non-root
MYSQL_USER=wpuser

WP_TITLE=Inception

# WP Admin
WP_ADMIN_USER=siteowner
WP_ADMIN_EMAIL=[your-email@example.com]

# WP normal user required comment testing
WP_USER=editor
WP_USER_EMAIL=[your-email@example.com]